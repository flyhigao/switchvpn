<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.local.deactivatevpn"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ 包可见性：不声明的话 getPackageInfo() 看不到 v2rayNG -->
    <queries>
        <package android:name="com.v2ray.ang" />
        <package android:name="com.v2ray.ang.fdroid" />
    </queries>

    <application
        android:label="deactivateVpn"
        android:icon="@android:drawable/ic_menu_close_clear_cancel"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- 打开即执行，透明窗口，执行完立刻消失 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="deactivateVpn"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.local.deactivatevpn.task">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.local.deactivatevpn.action.OFF" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <!-- 无界面入口（可选，调试/自动化够强时可用） -->
        <!-- 10 秒防抖：到点由系统唤醒本进程执行 -->
        <service
            android:name="com.local.vpncommon.SettleJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".StartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.local.deactivatevpn.action.OFF" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
